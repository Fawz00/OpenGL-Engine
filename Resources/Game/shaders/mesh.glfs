#version 330 core

out vec4 FragColor;

in vec2 TexCoords;
in vec3 Normal;
in vec3 Position;
in vec4 vColor;
in mat3 TBN;

#ifdef SHADOW_MAPPING
in vec4 FragPosLightSpace;
#endif

uniform sampler2D texture_diffuse1;
uniform sampler2D texture_specular1;
uniform sampler2D texture_normal1;
uniform sampler2D texture_height1;

uniform sampler2D shadowMap;

uniform uint uTextureFlags;
uniform float uTime;
uniform vec3 uLightDir;
uniform vec3 uViewPos;

#define HAS_DIFFUSE  (1u << 0u)
#define HAS_SPECULAR (1u << 1u)
#define HAS_NORMAL   (1u << 2u)
#define HAS_HEIGHT   (1u << 3u)

void main()
{
    // Texture mapping
    float useDiffuse = float((uTextureFlags & HAS_DIFFUSE) != 0u);
    vec4 color = mix(vec4(1.0), texture(texture_diffuse1, TexCoords), useDiffuse);

    // Alpha test
#ifdef ALPHA_TEST
    if (color.a < 0.1)
        discard;
#endif

    vec3 lightColor = vec3(1.0, 0.85, 0.75) * 0.8;

    vec3 lightDir = normalize(-uLightDir);
    vec3 viewDir = normalize(uViewPos - Position);

    // Normal mapping
    float useNormal = float((uTextureFlags & HAS_NORMAL) != 0u);
    vec3 norm = mix(
    // False
        normalize(Normal),
    // True
        normalize( TBN * (texture(texture_normal1, TexCoords).rgb * 2.0 - 1.0) ),
    // ?
        useNormal
    );

	// Ambient
    vec3 ambient = vec3(0.4) * color.rgb;

	// diffuse 
    float diff = max(dot(norm, lightDir), 0.0);

    // Shadow
#ifdef SHADOW_MAPPING
    vec4 fragPosLightSpace = FragPosLightSpace;
    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    projCoords = projCoords * 0.5 + 0.5;
    float currentDepth = projCoords.z;

    // Shadow-map texel size
    vec2 texelSize = 1.0 / vec2(textureSize(shadowMap, 0));

    // Bias
    float bias = 1.73205080757 * texelSize.x;
    float biasedDepth = currentDepth - bias;

    int pcfSampleRadius = 2;
    float kernelScale = 1.312;
    float penumbraScale = 0.0025;

    float shadowSum = 0.0;
    float weightSum = 0.0;
    for (int x = -pcfSampleRadius; x <= pcfSampleRadius; ++x)
    {
        for (int y = -pcfSampleRadius; y <= pcfSampleRadius; ++y)
        {
            vec2 offset = vec2(x, y);

            // Distance from the center of the kernel.
            float kernelDistance = length(offset);

            // Sample shadow map.
            vec2 sampleUV =
                projCoords.xy +
                offset * texelSize * kernelScale;

            float sampleDepth =
                texture(shadowMap, sampleUV).r;

            // Normal hard-shadow comparison.
            float hardShadow =
                step(biasedDepth, sampleDepth);

            // Expanded depth threshold.
            float softShadow =
                step(
                    biasedDepth,
                    sampleDepth + kernelDistance * penumbraScale
                );

            float same =
                1.0 - abs(hardShadow - softShadow); // XNOR

            shadowSum += hardShadow * softShadow; // AND
            weightSum += same;
        }
    }

    float shadow = shadowSum / max(weightSum, 1.0);

    float shadowMask =
        step(currentDepth, 1.0) *
        step(projCoords.x, 1.0) *
        step(0.0, projCoords.x) *
        step(projCoords.y, 1.0) *
        step(0.0, projCoords.y);

    shadow = mix(1.0, shadow, shadowMask);

    diff *= shadow;
#endif
    
    vec3 diffuse = lightColor * diff * color.rgb;

    // Specular (Blinn-Phong)
    vec3 halfwayDir = normalize(lightDir + viewDir);
    float spec = pow(max(dot(norm, halfwayDir), 0.0), 64.0);

    float useSpecular = float((uTextureFlags & HAS_SPECULAR) != 0u);
    float specStrength = mix(
    // False
        0.2,
    // True
        texture(texture_specular1, TexCoords).r,
    // ?
        useSpecular
    );
    vec3 specular = lightColor * spec * specStrength;

    color = vec4(ambient + diffuse + specular, color.a);

	FragColor = color;
}